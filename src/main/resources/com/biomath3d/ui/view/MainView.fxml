<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane prefHeight="800.0" prefWidth="1200.0" styleClass="main-root" stylesheets="@../styles/window.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biomath3d.controller.MainController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <padding>
                <Insets top="15.0" right="25.0" bottom="15.0" left="25.0" />
            </padding>
            <children>
                <Label styleClass="logo-title" text="BioMath 3D" />
                <Region HBox.hgrow="ALWAYS" />
                <MenuButton fx:id="menuCuenta" styleClass="btn-cuenta">
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true" styleClass="icono-usuario"/>
                    </graphic>
                    <items>
                        <CustomMenuItem disable="true" hideOnClick="false">
                            <content><Label styleClass="menu-section-header" text="ARCHIVO" /></content>
                        </CustomMenuItem>
                        <MenuItem text="Nuevo Proyecto" onAction="#nuevoProyecto" />
                        <MenuItem text="Abrir Proyecto" onAction="#abrirProyecto" />
                        <MenuItem text="Exportar Imagen (.png)" onAction="#exportarImagen" />
                        <MenuItem text="Exportar Modelo 3D (.obj)" onAction="#exportarMallaOBJ" />

                        <SeparatorMenuItem />

                        <CustomMenuItem disable="true" hideOnClick="false">
                            <content><Label styleClass="menu-section-header" text="EDITAR" /></content>
                        </CustomMenuItem>
                        <MenuItem text="Copiar Imagen al Portapapeles" onAction="#copiarAlPortapapeles" />
                        <MenuItem text="Limpiar Historial SQLite" onAction="#limpiarHistorialBaseDatos" />

                        <SeparatorMenuItem />

                        <CustomMenuItem disable="true" hideOnClick="false">
                            <content><Label styleClass="menu-section-header" text="VER" /></content>
                        </CustomMenuItem>
                        <MenuItem text="Mostrar/Ocultar Ejes" onAction="#alternarEjes" />
                        <MenuItem text="Modo Alámbrico (Wireframe)" onAction="#alternarWireframe" />
                        <MenuItem text="Restablecer Cámara" onAction="#restablecerCamara" />

                        <SeparatorMenuItem />

                        <CustomMenuItem disable="true" hideOnClick="false">
                            <content><Label styleClass="menu-section-header" text="SISTEMA" /></content>
                        </CustomMenuItem>
                        <MenuItem fx:id="menuSalir" text="Salir" onAction="#cerrarVentana" />
                    </items>
                </MenuButton>
            </children>
        </HBox>
    </top>

    <left>
        <StackPane styleClass="side-wrapper">
            <children>
                <VBox prefWidth="280.0" spacing="15.0" styleClass="side-panel">
                    <children>
                        <Label styleClass="panel-label" text="Function Input" />
                        <TextField fx:id="txtFuncion" text="z = sin(x)*cos(y)" styleClass="input-field" />
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 10;">
                            <ComboBox fx:id="comboOperacion" promptText="Seleccionar operación" styleClass="combo-operacion" />
                            <Button fx:id="btnEjecutar" text="Ejecutar" onAction="#procesarOperacion" />
                        </HBox>
                        <Label maxWidth="1.7976931348623157E308" styleClass="domain-badge" text="(x, y) = [-5, 5] × [-5, 5]" />
                        <Region VBox.vgrow="ALWAYS" />
                        <Button fx:id="btnRender" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="btn-render" text="Render 3D" />
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>
            </children>
        </StackPane>
    </left>

    <center>
        <StackPane fx:id="centerContainer" styleClass="center-container">
            <children>
                <Label styleClass="placeholder-text" text="[ Área reservada para gráficos de Superficie 3D ]" />
            </children>
        </StackPane>
    </center>

    <bottom>
        <HBox prefHeight="220.0" spacing="15.0" styleClass="bottom-panel">
            <children>
                <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="card-title" text="Analysis Results" />
                        <Separator />
                    </children>
                </VBox>
                <VBox prefWidth="350.0" spacing="10.0" styleClass="card-panel">
                    <children>
                        <Label styleClass="card-title" text="History" />
                        <Separator />
                        <ListView fx:id="historyList" VBox.vgrow="ALWAYS" styleClass="history-list" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </bottom>
</BorderPane>